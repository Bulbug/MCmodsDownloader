{
  "name": "div-modpack-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DIV Modpack Builder - Search and download Minecraft mods from Modrinth",
  "author": {
    "name": "Bulbug",
    "email": "bulbug@example.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron ./electron/main.js",
    "electron:build": "npm run build && electron-builder",
    "release": "standard-version"
  },
  "main": "./electron/main.js",
  "homepage": "https://github.com/Bulbug/MCmodsDownloader",
  "dependencies": {
    "bluebird": "3.7.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-forge": "^5.2.4",
    "promise": "^8.3.0",
    "standard-version": "^9.5.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.div.modpackbuilder",
    "productName": "DIV Modpack Builder",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "category": "Game",
      "target": [
        "AppImage",
        "deb"
      ],
      "desktopName": "DIV Modpack Builder",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "icon": "src/assets/icon.svg"
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "section": "Chores"
      },
      {
        "type": "docs",
        "section": "Documentation"
      }
    ],
    "commitMessage": "chore(release): {{currentVersion}} → {{nextVersion}}",
    "tagMessage": "{{currentVersion}} → {{nextVersion}}"
  }
}
